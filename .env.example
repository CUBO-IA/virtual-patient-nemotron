OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
CHROMA_URL=http://localhost:8001
RAG_ENABLED=false
NUM_CTX=2048
# Pruebas, plan y control con casos aun sin validar por un profesional (solo demostraciones)
SEGUIMIENTO_DEMO=false

# Distancia maxima para considerar relevante un fragmento de guia (explicaciones "Por que?")
RAG_MAX_DISTANCIA=660
RAG_MAX_DISTANCIA_LEXICA=780

# Embeddings del RAG en CPU (recomendado con 6 GB de VRAM: evita recargar el modelo de lenguaje en cada consulta)
EMBED_EN_CPU=true

# Cargar los modelos al arrancar (la primera respuesta no tarda 10-20 s)
CALENTAR_MODELOS=true
